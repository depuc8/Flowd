# /etc/flowd/worker.env - configuration for flowd-worker.service.
# Do not put AWS access keys here; workers authenticate with the instance
# profile (IAM role) attached to the EC2 instance.
FLOWD_TABLE=flowd
AWS_REGION=us-east-1
# Must be identical for every worker and submitter using the table.
FLOWD_SHARDS=8
FLOWD_THREADS=8
FLOWD_LEASE_MS=30000
FLOWD_HEARTBEAT_MS=10000
FLOWD_DRAIN_TIMEOUT_MS=60000
FLOWD_LOG_LEVEL=info
